# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test artifacts
/test-results/
/playwright-report/
/playwright/.cache/

# local debug output
debug.log

# push reminder store (server-local)
.data/

# personal editor and AI-assistant setup (not needed to run or test the project)
/.vscode/
/.idea/
*.code-workspace
/.claude/
/.agents/
/.codex/
/CLAUDE.md
/AGENTS.md
.eslintcache

# OS files
Thumbs.db
[Dd]esktop.ini

# logs
*.log

# build specification and research (not needed to run or test the project)
/spec/
/research/
/GOAL.md
